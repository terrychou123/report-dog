# ── Required ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=    # 舊版欄位名：NEXT_PUBLIC_SUPABASE_ANON_KEY
DATABASE_URL=                            # Direct Postgres connection for Drizzle ORM

# ── Optional ──────────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=             # AI 功能（Claude via OpenRouter）
SUPABASE_SERVICE_ROLE_KEY=      # Admin 操作（invite users / cron cleanup / resolve shared owners）
ADMIN_EMAIL=                    # /admin 範本管理 gate
BLOG_ADMIN_EMAIL=               # /blog-admin gate
CRON_SECRET=                    # Vercel cron job Bearer token（api/cron/cleanup-trials）
PUBLIC_DEMO_SALT=               # HMAC-SHA256 salt — IP hashing for public SOAP demo rate limiting（必填，缺少會導致所有 demo 請求 500）
RESEND_API_KEY=                 # 寄信（invite / newsletter）
FROM_EMAIL=                     # Resend 寄件人，預設 "報告汪 <noreply@reportwang.com>"
DOWNLOAD_TOKEN_SECRET=          # 32+ bytes random — HMAC download tokens（lib/downloads/token.ts）
RESEND_WEBHOOK_SECRET=          # Resend webhook signing secret（svix 格式 whsec_xxx）
UNSUBSCRIBE_TOKEN_SECRET=       # 32+ bytes random — HMAC unsubscribe tokens；生成：openssl rand -hex 32
UNSUBSCRIBE_REPLY_TO=           # Reply-To header for newsletter（e.g. 報告汪退訂 <unsubscribe@xxx.resend.app>）
UNSUBSCRIBE_INBOX_ADDRESS=      # List-Unsubscribe mailto header（e.g. unsubscribe@xxx.resend.app）
NEXT_PUBLIC_GA_ID=              # GA4 Measurement ID — 注意：layout.tsx 已硬寫 G-HVVZ9LQR8F，此欄位目前未被讀取

# ── GSC / GA CLI scripts（scripts/gsc.ts, scripts/ga-health.ts）──────────────
GSC_SITE=                       # 預設 sc-domain:reportwang.com；可用 --site= CLI flag 覆寫
GA_PROPERTY_ID=                 # 預設 532405604（報告汪流量分析 property）
